NEXT_PUBLIC_SITE_URL=https://www.upprocure.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in Vercel for serving static assets from R2.
R2_PUBLIC_URL=https://assets.example.com
USE_R2_ASSETS=true

# Local asset sync only. Do not add these write credentials to Vercel unless
# ADMIN_CONSOLE_ENABLED and ADMIN_UPLOADS_ENABLED are intentionally enabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
ADMIN_CONSOLE_ENABLED=false
ADMIN_UPLOADS_ENABLED=false

RESEND_API_KEY=
RESEND_FROM_EMAIL=sales@upprocure.com
NOTIFICATION_EMAILS=sales@example.com
